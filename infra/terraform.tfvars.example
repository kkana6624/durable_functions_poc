# Authentication is opt-in; Entra registrations/App Role assignments/idtyp remain external prerequisites.
workflow_auth_mode = "PocFunctionKey"
# To enable EntraEasyAuth, supply all five values below. Function keys remain required.
# workflow_auth_tenant_id = "<tenant-guid>"
# workflow_auth_api_client_id = "<api-application-client-guid>"
# workflow_auth_audience = "api://<api-application-client-guid>"
# workflow_auth_allowed_backend_app_ids = ["<backend-application-client-guid>"]
# workflow_auth_required_app_role = "Workflow.Invoke"
# az account show --query id -o tsv
subscription_id     = "00000000-0000-0000-0000-000000000000"
# Existing RG for PoC resources. Never create/import the shared RG into state.
resource_group_name = "existing-poc-rg"
name_suffix         = "replaceunique001"
# DTS requires a separate environment/state; Azure Storage history and entities are not migrated.
durable_backend       = "azureStorage"
durable_task_hub_name = "PocBatchHub"
validation_vm_ssh_public_key = "ssh-ed25519 <your-public-key>"
# Optional: explicitly grant the initiating user's/service principal's object ID access to the control container.
# validation_operator_principal_id = "00000000-0000-0000-0000-000000000000"

# az batch account show -g <batch-rg> -n <account> --query id -o tsv
batch_account_id = "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Batch/batchAccounts/<batch-account>"
# az batch account show -g <batch-rg> -n <account> --query accountEndpoint -o tsv
# Add https:// if Azure CLI returns only the hostname.
batch_endpoint = "https://your-batch-account.your-region.batch.azure.com"
batch_pool_id  = "existing-windows-pool"

# Read existing pool deployment/configuration (or Portal > Pool > Image reference).
# Evidence only: Terraform does not change or grant access to this image.
# Do not set gallery_image_version_id in existing mode.
# Existing image reference: /subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.Compute/galleries/<gallery>/images/<image>/versions/1.0.0
# batch_node_type/count apply only to new pools; existing dedicated/Spot targets remain untouched.
batch_poll_seconds       = 10
workflow_timeout_minutes = 15
