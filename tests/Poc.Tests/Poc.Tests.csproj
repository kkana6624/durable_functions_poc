    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
    <ProjectReference Include="../../src/Poc.Core/Poc.Core.csproj" />
    <ProjectReference Include="../../src/Poc.Functions/Poc.Functions.csproj" />
  </ItemGroup>
</Project>
