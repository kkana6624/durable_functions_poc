{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppServiceAuth": {
    "Mode": "Stub",
    "DefaultOwnerId": null,
    "DefaultOrgId": null,
    "AllowAnonymousInStub": false
  },
  "WorkflowClient": {
    "FunctionAppUrl": "http://localhost:7071",
    "AuthMode": "PocFunctionKey",
    "FunctionKey": null,
    "EntraAudience": null,
    "TimeoutSeconds": 30
  },
  "UploadService": {
    "DefaultContainer": "workflow-input",
    "MaxUploadSizeBytes": 53687091200
  }
}
